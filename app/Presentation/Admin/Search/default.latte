{block content}
<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow border-0">
            <div class="card-header bg-elysia-pink text-white text-center py-4 rounded-top">
                <i class="bi bi-search display-4"></i>
                <h3 class="mt-2 mb-0 fw-bold">Hledat uživatele</h3>
            </div>
            
            <div class="card-body p-4">
                <p class="text-muted text-center mb-4">
                    Vložte jméno nebo email, abyste našli uživatele.
                </p>
                
                <div class="d-grid gap-2">
                    {control searchForm}
                </div>
            </div>
        </div>
    </div>
</div>
{/block}