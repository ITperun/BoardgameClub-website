{block content}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-pink mb-0">
        <i class="bi bi-stars me-2"></i> Výsledky hledání
    </h2>
    <a n:href="default" class="btn btn-outline-secondary rounded-pill px-4">
        <i class="bi bi-arrow-left me-1"></i> Hledat znovu
    </a>
</div>

<div class="alert alert-light border shadow-sm mb-4 d-flex align-items-center" role="alert">
    <i class="bi bi-info-circle-fill text-info me-2 fs-5"></i>
    <span>
        Základní hledání: <strong>"{$keyword}"</strong>
    </span>
</div>

{if $results}
    <div class="card shadow-sm border-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-secondary small text-uppercase">
                    <tr>
                        <th class="ps-4 py-3">ID</th>
                        <th>Uživatel</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th class="text-end pe-4">Akce</th>
                    </tr>
                </thead>
                <tbody>
                {foreach $results as $u}
                    <tr>
                        <td class="ps-4 text-muted fw-bold">#{$u->id}</td>
                        <td>
                            <div class="d-flex align-items-center">
                                <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 36px; height: 36px;">
                                    <i class="bi bi-person-fill"></i>
                                </div>
                                <span class="fw-bold text-dark">{$u->username}</span>
                            </div>
                        </td>
                        <td>
                            <a href="mailto:{$u->email}" class="text-decoration-none text-muted">
                                {$u->email}
                            </a>
                        </td>
                        <td>
                            {var $badgeClass = $u->role->name == 'admin' ? 'bg-danger' : ($u->role->name == 'moderator' ? 'bg-warning text-dark' : 'bg-success')}
                            <span class="badge {$badgeClass} rounded-pill px-3 py-2">
                                {$u->role->name}
                            </span>
                        </td>
                        <td class="text-end pe-4">
                            <a n:href="User:detail $u->id" class="btn btn-sm btn-light text-primary" title="Просмотр">
                                <i class="bi bi-eye-fill"></i>
                            </a>
                        </td>
                    </tr>
                {/foreach}
                </tbody>
            </table>
        </div>
    </div>
    
    <div class="mt-3 text-muted small text-end">
        Nalezeno záznamů: {count($results)}
    </div>

{else}
    <div class="text-center py-5 bg-white rounded shadow-sm">
        <div class="mb-3">
            <i class="bi bi-search text-secondary opacity-25" style="font-size: 4rem;"></i>
        </div>
        <h4 class="text-muted">Nic</h4>
        <p class="text-muted mb-4">Zkuste změnit dotaz nebo zkontrolovat překlepy.</p>
        <a n:href="default" class="btn btn-primary bg-elysia-pink border-0 px-4 rounded-pill">
            Try again
        </a>
    </div>
{/if}
{/block}