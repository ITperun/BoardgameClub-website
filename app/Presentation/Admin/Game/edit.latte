{block content}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">Upravit hru</h2>
        <a n:href="default" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Zpět na seznam
        </a>
    </div>

    <div class="card shadow-sm border-0 p-4 bg-white rounded">
        {control gameForm}
    </div>
</div>
{/block}