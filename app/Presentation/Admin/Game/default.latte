{block content}
<div class="container mt-4">
    <h2 class="fw-bold mb-4">Správa her</h2>

    <table class="table table-striped table-bordered align-middle">
        <thead>
            <tr>
                <th>ID</th>
                <th>Název</th>
                <th>Žánr</th>
                <th class="text-center">Akce</th>
            </tr>
        </thead>
        <tbody>
            {foreach $games as $game}
                <tr>
                    <td>{$game->id}</td>
                    <td>{$game->name}</td>
                    <td>
                        {if $game->genre}
                            <span class="badge bg-info text-dark">{$game->genre}</span>
                        {else}
                            <span class="text-muted">N/A</span>
                        {/if}
                    </td>
                    <td class="text-center">
                        <a n:href="edit, id => $game->id" class="btn btn-sm btn-primary">
                            <i class="bi bi-pencil me-1"></i> Upravit
                        </a>
                        <a n:href="delete!, id => $game->id"
                          class="btn btn-sm btn-danger ms-1"
                          onclick="return confirm(
                           'Opravdu chcete tuto hru smazat? ' +
                             'Všechny události přiřazené k této hře zůstanou, ' +
                             'ale ztratí svůj žánr.'
                             );">
                             <i class="bi bi-trash me-1"></i> Smazat
                        </a>
                    </td>
                </tr>
            {/foreach}
        </tbody>
    </table>
</div>
{/block}