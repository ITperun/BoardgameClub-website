{block content}
<div class="container-fluid p-0">
    
    <div class="card border-0 shadow-sm mb-4" style="background: linear-gradient(135deg, var(--admin-main), var(--admin-dark)); color: white; border-radius: var(--radius);">
        <div class="card-body p-4 p-md-5 d-flex align-items-center justify-content-between">
            <div>
                <h2 class="fw-bold mb-2">Vítejte zpět, {$user->identity->firstname}! 👋</h2>
                <p class="mb-0" style="color: var(--admin-light); font-size: 1.1rem;">
                    Tady je rychlý přehled toho, co se dnes děje v klubu.
                </p>
            </div>
            <div class="d-none d-md-block" style="opacity: 0.15;">
                <i class="bi bi-grid-1x2-fill" style="font-size: 6rem;"></i>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 12px;">
                <div class="card-body p-4 d-flex align-items-center">
                    <div class="flex-shrink-0 d-flex justify-content-center align-items-center rounded-3" style="width: 54px; height: 54px; background-color: var(--admin-light); color: var(--admin-dark);">
                        <i class="bi bi-people-fill fs-4"></i>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="mb-1 text-muted fw-semibold" style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px;">Uživatelé</h6>
                        <h3 class="mb-0 fw-bold text-dark">124</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 12px;">
                <div class="card-body p-4 d-flex align-items-center">
                    <div class="flex-shrink-0 d-flex justify-content-center align-items-center rounded-3" style="width: 54px; height: 54px; background-color: #e0e7ff; color: #4338ca;">
                        <i class="bi bi-controller fs-4"></i>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="mb-1 text-muted fw-semibold" style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px;">Deskové hry</h6>
                        <h3 class="mb-0 fw-bold text-dark">48</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 12px;">
                <div class="card-body p-4 d-flex align-items-center">
                    <div class="flex-shrink-0 d-flex justify-content-center align-items-center rounded-3" style="width: 54px; height: 54px; background-color: #dcfce7; color: #15803d;">
                        <i class="bi bi-calendar-event-fill fs-4"></i>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="mb-1 text-muted fw-semibold" style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px;">Nadcházející události</h6>
                        <h3 class="mb-0 fw-bold text-dark">12</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 12px;">
                <div class="card-body p-4 d-flex align-items-center">
                    <div class="flex-shrink-0 d-flex justify-content-center align-items-center rounded-3" style="width: 54px; height: 54px; background-color: #fef3c7; color: #b45309;">
                        <i class="bi bi-bell-fill fs-4"></i>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="mb-1 text-muted fw-semibold" style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px;">Ke schválení</h6>
                        <h3 class="mb-0 fw-bold text-dark">3</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm h-100" style="border-radius: var(--radius);">
                <div class="card-header bg-white border-0 pt-4 pb-0 px-4">
                    <h5 class="fw-bold mb-0" style="color: var(--text-dark);">🕒 Poslední aktivita</h5>
                </div>
                <div class="card-body p-4 d-flex flex-column justify-content-center align-items-center text-center" style="min-height: 250px;">
                    <div style="background-color: var(--bg-body); width: 80px; height: 80px;" class="rounded-circle d-flex justify-content-center align-items-center mb-3">
                        <i class="bi bi-inbox text-muted fs-1"></i>
                    </div>
                    <h6 class="fw-bold text-dark">Zatím tu nic není</h6>
                    <p class="text-muted small mb-0 w-75">Jakmile začnou uživatelé přidávat hry nebo vytvářet události, historie se zobrazí zde.</p>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm h-100" style="border-radius: var(--radius);">
                <div class="card-header bg-white border-0 pt-4 pb-0 px-4">
                    <h5 class="fw-bold mb-0" style="color: var(--text-dark);">⚡ Rychlé akce</h5>
                </div>
                <div class="card-body p-4">
                    <div class="d-grid gap-3">
                        <a href="#" class="btn btn-light d-flex align-items-center text-start p-3" style="border: 1px solid #e2e8f0; border-radius: 10px;">
                            <i class="bi bi-plus-circle-fill me-3 fs-4" style="color: var(--admin-main);"></i>
                            <div>
                                <strong class="d-block" style="color: var(--text-dark);">Přidat novou hru</strong>
                                <small class="text-muted">Rozšířit katalog deskových her</small>
                            </div>
                        </a>
                        
                        <a n:href=":Admin:Event:default" class="btn btn-light d-flex align-items-center text-start p-3" style="border: 1px solid #e2e8f0; border-radius: 10px;">
                            <i class="bi bi-calendar-plus-fill me-3 fs-4 text-success"></i>
                            <div>
                                <strong class="d-block" style="color: var(--text-dark);">Spravovat události</strong>
                                <small class="text-muted">Vytvořit nebo upravit turnaj</small>
                            </div>
                        </a>

                        <a n:href="User:default" class="btn btn-light d-flex align-items-center text-start p-3" style="border: 1px solid #e2e8f0; border-radius: 10px;">
                            <i class="bi bi-person-lines-fill me-3 fs-4 text-primary"></i>
                            <div>
                                <strong class="d-block" style="color: var(--text-dark);">Seznam uživatelů</strong>
                                <small class="text-muted">Správa rolí a přístupů</small>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{/block}