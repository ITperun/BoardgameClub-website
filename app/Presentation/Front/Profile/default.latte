{block content}
<div class="container mt-4 mb-5">
    <h2 class="fw-bold mb-4" style="color: var(--text-dark); letter-spacing: -0.5px;">👤 Můj profil</h2>

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card h-100 border-0" style="box-shadow: var(--shadow-sm); border-radius: var(--radius);">
                <div class="card-body text-center p-4">
                    
                    <div class="position-relative d-inline-block mb-3">
                        {if $userData->image}
                            <img src="{$basePath}/{$userData->image}" alt="Avatar" 
                                 class="rounded-circle shadow-sm" 
                                 style="width: 140px; height: 140px; object-fit: cover; border: 4px solid var(--orange-light);">
                        {else}
                            <img src="{$basePath}/upload/avatars/default.png" alt="No Avatar" 
                                 class="rounded-circle shadow-sm opacity-75" 
                                 style="width: 140px; height: 140px; object-fit: cover; border: 4px solid var(--orange-light); filter: grayscale(10%);">
                        {/if}
                    </div>

                    <h4 class="fw-bold mb-1" style="color: var(--text-dark);">{$userData->firstname} {$userData->lastname}</h4>
                    <p class="mb-4" style="color: var(--text-muted); font-weight: 500;">@{$userData->username}</p>

                    <div class="text-start p-3 rounded-3" style="background-color: var(--bg-body); border: 1px solid #f1f5f9;">
                        <table class="table table-sm table-borderless mb-0">
                            <tbody>
                                <tr>
                                    <th class="py-2 w-50" style="color: var(--text-muted); font-weight: 500;">Email</th>
                                    <td class="py-2 text-end fw-medium" style="color: var(--text-dark);">{$userData->email}</td>
                                </tr>
                                <tr>
                                    <th class="py-2" style="color: var(--text-muted); font-weight: 500;">Datum narození</th>
                                    <td class="py-2 text-end fw-medium" style="color: var(--text-dark);">{$userData->birthdate|date:'j. n. Y'}</td>
                                </tr>
                                <tr>
                                    <th class="py-2" style="color: var(--text-muted); font-weight: 500;">Role</th>
                                    <td class="py-2 text-end">
                                        <span class="badge" style="background-color: var(--orange-main); padding: 0.5em 0.8em; font-weight: 600; letter-spacing: 0.5px;">
                                            {$userData->ref('roles', 'role_id')->name}
                                        </span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card h-100 border-0" style="box-shadow: var(--shadow-sm); border-radius: var(--radius); overflow: hidden;">
                <div class="card-header border-0 px-4 py-3" style="background: linear-gradient(135deg, var(--orange-dark), var(--orange-main));">
                    <h5 class="mb-0 text-white fw-bold">⚙️ Upravit profil</h5>
                </div>
                
                <div class="card-body p-4 bg-white">
                    {control profileForm}
                </div>
            </div>
        </div>
    </div>
</div>
{/block}