{import 'form-bootstrap5.latte'}

<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width">

    <title>{ifset title}{include title|stripHtml} | {/ifset}Klub deskových her</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
          crossorigin="anonymous">

    <style>
        :root {
            --orange-main: #f97316; /* Более современный, сочный оранжевый */
            --orange-light: #ffedd5;
            --orange-dark: #c2410c;
            --bg-body: #f8fafc; /* Легкий холодный оттенок для контраста с теплыми карточками */
            --bg-card: #ffffff;
            --text-dark: #1e293b; 
            --text-muted: #64748b;
            --shadow-sm: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
            --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
            --radius: 16px;
        }

        html, body {
            height: 100%;
            margin: 0;
            display: flex;
            flex-direction: column;
            background-color: var(--bg-body);
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
            color: var(--text-dark);
            -webkit-font-smoothing: antialiased;
        }

        .container {
            flex: 1 0 auto;
            max-width: 1140px;
        }

        /* HEADER */
        header {
            position: sticky;
            top: 0;
            z-index: 1050;
            background: linear-gradient(135deg, var(--orange-dark), var(--orange-main));
            color: white;
            padding: 1rem 1.5rem;
            box-shadow: var(--shadow-sm);
            border-radius: 0 0 var(--radius) var(--radius);
        }
        header h1 { 
            margin: 0; 
            font-size: 1.6rem; 
            font-weight: 800; 
            letter-spacing: -0.5px; 
        }
        
        /* NAVIGATION */
        .nav-link {
            font-weight: 500;
            opacity: 0.9;
            transition: all 0.2s ease;
            border-radius: 8px;
            margin: 0 2px;
        }
        .nav-link:hover {
            opacity: 1;
            background-color: rgba(255, 255, 255, 0.15);
            transform: translateY(-1px);
        }

        /* HERO */
        .hero {
            margin-top: 2.5rem;
            background: linear-gradient(135deg, #ffffff, var(--orange-light));
            border-radius: var(--radius);
            box-shadow: var(--shadow-sm);
            padding: 3rem 2rem;
            text-align: center;
            border: 1px solid rgba(249, 115, 22, 0.1);
        }
        .hero p { 
            color: var(--text-dark); 
            font-size: 1.25rem; 
            font-weight: 500; 
            margin: 0; 
        }

        /* MAIN SECTION */
        main {
            background-color: var(--bg-card);
            border-radius: var(--radius);
            padding: 2.5rem;
            box-shadow: var(--shadow-sm);
            margin-top: 2rem;
            border: 1px solid #f1f5f9;
        }

        /* EVENT CARDS */
        .event-preview { margin-top: 3rem; }
        .event-preview h3 { 
            font-weight: 700; 
            color: var(--text-dark); 
            letter-spacing: -0.5px; 
            margin-bottom: 1.5rem !important;
        }
        
        .event-card {
            background: var(--bg-card);
            border-left: 6px solid var(--orange-main);
            padding: 1.5rem;
            border-radius: 12px;
            box-shadow: var(--shadow-sm);
            margin-bottom: 1.25rem;
            border-top: 1px solid #f1f5f9;
            border-right: 1px solid #f1f5f9;
            border-bottom: 1px solid #f1f5f9;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .event-card:hover {
            transform: translateY(-4px) scale(1.01);
            box-shadow: var(--shadow-lg);
            border-left-color: var(--orange-dark);
        }
        .event-card h5 { color: var(--text-dark); font-size: 1.25rem; }
        .event-card p { color: var(--text-muted); }

        /* BUTTONS */
        .btn {
            font-weight: 600;
            padding: 0.5rem 1.25rem;
            border-radius: 8px;
            transition: all 0.2s ease;
        }
        .btn-primary { 
            background-color: var(--orange-main); 
            border: none; 
            box-shadow: 0 2px 4px rgba(249, 115, 22, 0.3);
        }
        .btn-primary:hover { 
            background-color: var(--orange-dark); 
            transform: translateY(-1px);
            box-shadow: 0 4px 6px rgba(249, 115, 22, 0.4);
        }
        .btn-secondary { 
            background-color: white; 
            color: var(--text-dark); 
            border: 1px solid #cbd5e1; 
        }
        .btn-secondary:hover { 
            background-color: #f8fafc; 
            border-color: #94a3b8;
            color: var(--text-dark);
        }
        .btn-light {
            background-color: rgba(255,255,255,0.2);
            color: white !important;
            border: none;
        }
        .btn-light:hover {
            background-color: rgba(255,255,255,0.3);
            color: white !important;
        }

        /* ALERTS */
        .alert { border-radius: 12px; border: none; font-weight: 500; }

        /* USER PROFILE */
        .nav-user {
            background-color: rgba(255, 255, 255, 0.1);
            padding: 0.4rem 0.8rem 0.4rem 0.4rem;
            border-radius: 50px;
            transition: background-color 0.2s ease;
        }
        .nav-user:hover { background-color: rgba(255, 255, 255, 0.15); }
        .nav-user img { 
            width: 38px; 
            height: 38px; 
            border-radius: 50%; 
            object-fit: cover; 
            border: 2px solid white; 
            margin-right: 12px; 
        }
        .user-info { display: flex; flex-direction: column; line-height: 1.2; color: white; }
        .user-info .name { font-weight: 600; font-size: 0.95rem; }
        .user-info .role { 
            font-size: 0.75rem; 
            color: var(--orange-light); 
            opacity: 0.9; 
            text-transform: uppercase; 
            letter-spacing: 0.5px; 
            font-weight: 600;
        }

        /* FOOTER */
        footer {
            flex-shrink: 0;
            color: var(--text-muted);
            text-align: center;
            padding: 2rem 0;
            font-size: 0.95rem;
            background: transparent;
            margin-top: 3rem;
            font-weight: 500;
        }
    </style>
</head>

<body>
    <div class="container">
        <header class="d-flex justify-content-between align-items-center px-3">
            <h1>🎲 Klub deskových her</h1>

            <nav class="d-none d-md-flex align-items-center me-3">
                <ul class="nav">
                    <li class="nav-item">
                        <a n:href=":Front:Home:default" class="nav-link text-white px-2">Domů</a>
                    </li>
                    <li class="nav-item">
                        <a n:href=":Front:Event:default" class="nav-link text-white px-2">Události</a>
                    </li>

{if $user->isLoggedIn() && in_array($user->identity->role, ['organizer', 'admin'])}
    <li class="nav-item">
        <a n:href=":Front:Organizer:default" class="nav-link text-white px-2">Moje akce</a>
    </li>
{/if}

{if $user->isLoggedIn() && $user->identity->role === 'admin'}
    <li class="nav-item">
        <a n:href=":Admin:Dashboard:default" class="nav-link text-white px-2">Admin</a>
    </li>
{/if}

{if $user->isLoggedIn() && in_array($user->identity->role, ['admin','moderator'])}
    <li class="nav-item">
        <a n:href=":Admin:Event:moderation" class="nav-link text-white px-2">Moderování</a>
    </li>
{/if}
                </ul>
            </nav>

            <div class="d-flex align-items-center">
                {if !$user->isLoggedIn()}
                    <a n:href=":Front:Sign:in" class="btn btn-primary me-2">Přihlásit</a>
                    <a n:href=":Front:Sign:up" class="btn btn-secondary">Registrovat</a>
                {else}
                    <div class="d-flex align-items-center nav-user">
                        {* Ссылка на профиль *}
                        <a n:href=":Front:Profile:default" class="d-flex align-items-center text-decoration-none text-white me-3" title="Můj profil">
                            <img src="{$basePath}/{$user->identity->image ?: 'upload/avatars/default.png'}" alt="Avatar">
                            <div class="user-info">
                                <span class="name">{$user->identity->firstname} {$user->identity->lastname}</span>
                                <span class="role">{$user->identity->role|capitalize}</span>
                            </div>
                        </a>
                        
                        <a n:href=":Front:Sign:out" class="btn btn-sm btn-light text-dark">Odhlásit</a>
                    </div>
                {/if}
            </div>
        </header>

        {* Показывать только на главной странице *}
        {if $presenter->name === 'Front:Home:Home'}
            <div class="hero">
                <p>Objevujte nové hry, poznávejte přátele a zažijte zábavu u našeho společného stolu.</p>
            </div>

            <div class="event-preview">
    <h3 class="mb-3">🧩 Nadcházející události</h3>

    {if isset($events) && count($events)}
        {foreach $events as $upcomingEvent}
            <div class="event-card">
                <h5 class="mb-1 fw-bold text-dark">{$upcomingEvent->title}</h5>
                <p class="mb-1"><small><strong>Datum:</strong> {$upcomingEvent->start_time|date:'j. n. Y H:i'}</small></p>
                <p class="mb-2">{$upcomingEvent->description|truncate:120}</p>

                {if !$user->isLoggedIn()}
                    <a n:href=":Front:Sign:in" class="btn btn-sm btn-primary">Přihlásit se k účasti</a>
                {else}
                    <a n:href=":Front:Event:detail, id => $upcomingEvent->id" class="btn btn-sm btn-primary">Zobrazit / Přijmout účast</a>
                {/if}
            </div>
        {/foreach}
    {else}
        <div class="alert alert-warning">Zatím nejsou žádné plánované události…</div>
    {/if}
</div>
        {/if}

        <main>
            {foreach $flashes as $flash}
                <div class="alert alert-{$flash->type} mt-2">{$flash->message}</div>
            {/foreach}

            {include content}
        </main>
    </div>

    <footer>
        &copy; {date('Y')} Klub deskových her — školní projekt (MOP)
    </footer>

    {block scripts}
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
        <script src="https://unpkg.com/nette-forms@3"></script>
    {/block}
</body>
</html>